rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /photography_posts/{postId} {
      // Anyone can view the photography feed
      allow read: if true;
      
      // Users must be authenticated, and the data's creatorUid must match their actual logged-in UID
      allow create: if request.auth != null 
                    && request.resource.data.creatorUid == request.auth.uid;
      
      // Allows authenticated users to increment likes or add comments
      allow update: if request.auth != null;
      
      // STRICT OWNERSHIP: A user can only delete a document if they created it
      allow delete: if request.auth != null 
                    && resource.data.creatorUid == request.auth.uid;
    }
    
  }
}
