rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Secure Rule: Tracks files nested under the user's explicit UID folder
    match /social_feed/{userId}/{allPaths=**} {
      // Anyone can view images so the feed renders properly
      allow read: if true;
      
      // Users can only upload (create) or delete images inside their own dedicated folder
      allow create, delete: if request.auth != null && request.auth.uid == userId;
    }
    
  }
}
